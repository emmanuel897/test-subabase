{
  "name": "supabase-test-project",
  "version": "1.0.0",
  "description": "Projet de test avec Supabase - opérations CRUD sur une base de données",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "db:migrate": "node src/db/migrate.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.3.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "transform": {},
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
